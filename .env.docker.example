# Docker Environment Configuration
# Copy this file to .env.docker and fill in your values
# Then run: docker-compose --env-file .env.docker up

# Anthropic API Key (REQUIRED)
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# ElevenLabs Configuration
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_dutch_voice_id_here
# Voice ID for American English (optional, for en-US dictations)
ELEVENLABS_VOICE_ID_EN_US=your_english_voice_id_here

# Secret token for /create route access (PoC/demo protection)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or use: docker-compose run diction node scripts/generate-token.js
CREATE_SECRET_TOKEN=7f9a2b4e8c1d6f3a9e5b2c7d4f8a1b6e3c5d7e9f1a3b5c7d9e1f3a5b7c9d1e3f

# Passphrase for /create access (public-facing alternative to secret token)
# When set, visitors see a passphrase form instead of a 403 page.
# Both mechanisms can coexist: token in URL bypasses the passphrase form.
CREATE_PASSPHRASE=

# Admin secret for delete access (login at /admin/login)
ADMIN_SECRET=
