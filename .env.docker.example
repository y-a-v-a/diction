# Docker Environment Configuration
# Copy this file to .env.docker and fill in your values
# Then run: docker-compose --env-file .env.docker up

# Claude API Key (REQUIRED)
# Get from: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-xxx

# Text-to-Speech Service Selection
# Options: 'elevenlabs' or 'resemble'
TTS_SERVICE=elevenlabs

# ElevenLabs Configuration (if using TTS_SERVICE=elevenlabs)
# Get from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_dutch_voice_id_here

# Resemble.ai Configuration (if using TTS_SERVICE=resemble)
# Get from: https://app.resemble.ai/
RESEMBLE_API_KEY=your_resemble_api_key_here
RESEMBLE_VOICE_UUID=your_voice_uuid_here

# Secret token for /create route access (PoC/demo protection)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or use: docker-compose run diction node scripts/generate-token.js
CREATE_SECRET_TOKEN=7f9a2b4e8c1d6f3a9e5b2c7d4f8a1b6e3c5d7e9f1a3b5c7d9e1f3a5b7c9d1e3f

# Automatic Weekly Generation (Cost Control for TTS API)
# Enable automatic weekly dictation generation to control API costs
# Set to 'false' to disable (manual only via secret token)
ENABLE_AUTO_GENERATION=true

# Cron schedule for automatic generation (every Monday at 9:00 AM by default)
# Format: minute hour day-of-month month day-of-week
CRON_SCHEDULE=0 9 * * 1
