{
  "name": "diction",
  "version": "1.0.0",
  "description": "Dutch dictation webapp with Claude SDK and ElevenLabs integration",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "token:generate": "node scripts/generate-token.js",
    "token:setup": "node scripts/setup-token.js",
    "token:url": "node scripts/show-create-url.js",
