{
  "name": "diction",
  "version": "1.0.0",
  "description": "Dutch dictation webapp with Claude SDK and ElevenLabs integration",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "token:generate": "node --env-file=.env scripts/generate-token.js",
    "token:setup": "node --env-file=.env scripts/setup-token.js",
    "token:url": "node --env-file=.env scripts/show-create-url.js"
  },
  "keywords": [
    "dictation",
    "dutch",
    "education"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@vercel/blob": "^2.5.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  }
}
