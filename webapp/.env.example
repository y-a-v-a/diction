# Claude API Key (from https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-xxx

# ElevenLabs Configuration
# API Key from https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID for Dutch voice (default) - find at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=your_dutch_voice_id_here
# Voice ID for American English voice (optional, for en-US dictations)
# Follow the pattern ELEVENLABS_VOICE_ID_{LANG_CODE} for additional languages
ELEVENLABS_VOICE_ID_EN_US=your_english_voice_id_here

# Server port
PORT=3000

# Secret token for /create route access (PoC/demo protection)
# Only users with this token can access the creation page
# Access via: /create?token=YOUR_SECRET_TOKEN
#
# Generate and setup token automatically:
#   npm run token:setup       - Generates token and adds to .env
#   npm run token:url         - Shows the create URL with your token
#   npm run token:generate    - Just generates a token (doesn't save)
#
# Or manually generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREATE_SECRET_TOKEN=7f9a2b4e8c1d6f3a9e5b2c7d4f8a1b6e3c5d7e9f1a3b5c7d9e1f3a5b7c9d1e3f

# Passphrase for /create access (public-facing alternative to secret token)
# When set, visitors see a passphrase form instead of a 403 page.
# A correct entry grants a 24-hour cookie so they don't have to re-enter.
# Both mechanisms can coexist: token in URL bypasses the passphrase form.
CREATE_PASSPHRASE=

# ===== Admin login via Google (social login) =====
# Admins sign in at /admin/login with their Google account to manage
# dictations (delete access). Create OAuth credentials at:
#   https://console.cloud.google.com/apis/credentials
# Add an Authorized redirect URI of:  <your-origin>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: explicit OAuth callback URL.
# If unset, it is derived from the incoming request, e.g.
#   http://localhost:3000/auth/google/callback
GOOGLE_CALLBACK_URL=

# Comma-separated allowlist of Google account emails granted admin access.
# If empty, no one is an admin and delete buttons are hidden for everyone.
ADMIN_EMAILS=

# Secret used to sign the admin session cookie (HMAC).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to GOOGLE_CLIENT_SECRET if unset, but a dedicated value is recommended.
SESSION_SECRET=
