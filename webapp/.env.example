# Claude API Key (from https://console.anthropic.com/)
CLAUDE_API_KEY=sk-ant-xxx

# Text-to-Speech Service Selection
# Options: 'elevenlabs' or 'resemble'
TTS_SERVICE=elevenlabs

# ElevenLabs Configuration (if using TTS_SERVICE=elevenlabs)
# API Key from https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Voice ID for Dutch voice - find at https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=your_dutch_voice_id_here

# Resemble.ai Configuration (if using TTS_SERVICE=resemble)
# API Key from https://app.resemble.ai/
RESEMBLE_API_KEY=your_resemble_api_key_here
# Voice UUID from your Resemble.ai project
RESEMBLE_VOICE_UUID=your_voice_uuid_here

# Server port
PORT=3000
